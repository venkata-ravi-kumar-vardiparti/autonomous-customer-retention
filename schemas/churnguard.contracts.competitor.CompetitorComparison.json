{
  "$defs": {
    "ClaimReconciliation": {
      "additionalProperties": false,
      "description": "Verdict on whether the customer's stated competitor claim holds up.",
      "properties": {
        "customer_claim": {
          "anyOf": [
            {
              "$ref": "#/$defs/CompetitorClaim"
            },
            {
              "type": "null"
            }
          ]
        },
        "explanation": {
          "title": "Explanation",
          "type": "string"
        },
        "resolved_price": {
          "anyOf": [
            {
              "type": "number"
            },
            {
              "type": "null"
            }
          ],
          "title": "Resolved Price"
        },
        "verdict": {
          "enum": [
            "confirmed",
            "overstated",
            "understated",
            "unverifiable"
          ],
          "title": "Verdict",
          "type": "string"
        }
      },
      "required": [
        "customer_claim",
        "verdict",
        "resolved_price",
        "explanation"
      ],
      "title": "ClaimReconciliation",
      "type": "object"
    },
    "CompetitorClaim": {
      "additionalProperties": false,
      "description": "A price or offer the customer says a competitor is providing.",
      "properties": {
        "carrier": {
          "title": "Carrier",
          "type": "string"
        },
        "price": {
          "minimum": 0.0,
          "title": "Price",
          "type": "number"
        },
        "source": {
          "title": "Source",
          "type": "string"
        },
        "span_refs": {
          "items": {
            "type": "string"
          },
          "title": "Span Refs",
          "type": "array"
        },
        "unit": {
          "enum": [
            "per_line",
            "total",
            "ambiguous"
          ],
          "title": "Unit",
          "type": "string"
        }
      },
      "required": [
        "carrier",
        "price",
        "unit",
        "source",
        "span_refs"
      ],
      "title": "CompetitorClaim",
      "type": "object"
    },
    "Normalization": {
      "additionalProperties": false,
      "description": "How disparate competitor prices were made comparable.",
      "properties": {
        "assumptions": {
          "items": {
            "type": "string"
          },
          "title": "Assumptions",
          "type": "array"
        },
        "method": {
          "title": "Method",
          "type": "string"
        }
      },
      "required": [
        "method",
        "assumptions"
      ],
      "title": "Normalization",
      "type": "object"
    },
    "ResolvedCompetitorOffer": {
      "additionalProperties": false,
      "description": "A single competitor plan, normalized for comparison.",
      "properties": {
        "carrier": {
          "title": "Carrier",
          "type": "string"
        },
        "includes": {
          "items": {
            "type": "string"
          },
          "title": "Includes",
          "type": "array"
        },
        "line_count": {
          "minimum": 1,
          "title": "Line Count",
          "type": "integer"
        },
        "monthly_price": {
          "minimum": 0.0,
          "title": "Monthly Price",
          "type": "number"
        },
        "normalized_monthly_equivalent": {
          "minimum": 0.0,
          "title": "Normalized Monthly Equivalent",
          "type": "number"
        },
        "plan_name": {
          "title": "Plan Name",
          "type": "string"
        },
        "source_snapshot_id": {
          "title": "Source Snapshot Id",
          "type": "string"
        }
      },
      "required": [
        "carrier",
        "plan_name",
        "monthly_price",
        "line_count",
        "includes",
        "normalized_monthly_equivalent",
        "source_snapshot_id"
      ],
      "title": "ResolvedCompetitorOffer",
      "type": "object"
    },
    "SnapshotMeta": {
      "additionalProperties": false,
      "description": "Provenance of the price snapshot(s) used to build the comparison.",
      "properties": {
        "age_days": {
          "minimum": 0,
          "title": "Age Days",
          "type": "integer"
        },
        "as_of": {
          "format": "date",
          "title": "As Of",
          "type": "string"
        },
        "capture_method": {
          "title": "Capture Method",
          "type": "string"
        },
        "geography": {
          "title": "Geography",
          "type": "string"
        },
        "snapshot_id": {
          "title": "Snapshot Id",
          "type": "string"
        }
      },
      "required": [
        "as_of",
        "age_days",
        "geography",
        "capture_method",
        "snapshot_id"
      ],
      "title": "SnapshotMeta",
      "type": "object"
    },
    "SwitchingCosts": {
      "additionalProperties": false,
      "description": "One-time costs the customer would incur by switching carriers.",
      "properties": {
        "activation_fees": {
          "minimum": 0.0,
          "title": "Activation Fees",
          "type": "number"
        },
        "device_payoff_total": {
          "minimum": 0.0,
          "title": "Device Payoff Total",
          "type": "number"
        },
        "early_termination_fees_total": {
          "minimum": 0.0,
          "title": "Early Termination Fees Total",
          "type": "number"
        },
        "other_costs": {
          "minimum": 0.0,
          "title": "Other Costs",
          "type": "number"
        },
        "total": {
          "minimum": 0.0,
          "title": "Total",
          "type": "number"
        }
      },
      "required": [
        "device_payoff_total",
        "early_termination_fees_total",
        "activation_fees",
        "other_costs",
        "total"
      ],
      "title": "SwitchingCosts",
      "type": "object"
    }
  },
  "additionalProperties": false,
  "description": "Structured output of the Competitor agent for one query.",
  "properties": {
    "breakeven_months": {
      "anyOf": [
        {
          "type": "number"
        },
        {
          "type": "null"
        }
      ],
      "title": "Breakeven Months"
    },
    "claim_reconciliation": {
      "$ref": "#/$defs/ClaimReconciliation"
    },
    "confidence_penalty": {
      "maximum": 1.0,
      "minimum": 0.0,
      "title": "Confidence Penalty",
      "type": "number"
    },
    "freshness": {
      "enum": [
        "fresh",
        "aging",
        "stale"
      ],
      "title": "Freshness",
      "type": "string"
    },
    "normalization": {
      "$ref": "#/$defs/Normalization"
    },
    "resolved_offers": {
      "items": {
        "$ref": "#/$defs/ResolvedCompetitorOffer"
      },
      "title": "Resolved Offers",
      "type": "array"
    },
    "snapshot": {
      "$ref": "#/$defs/SnapshotMeta"
    },
    "switching_costs": {
      "$ref": "#/$defs/SwitchingCosts"
    }
  },
  "required": [
    "resolved_offers",
    "normalization",
    "switching_costs",
    "breakeven_months",
    "claim_reconciliation",
    "snapshot",
    "freshness",
    "confidence_penalty"
  ],
  "title": "CompetitorComparison",
  "type": "object"
}
