{
  "$defs": {
    "CompetitorClaim": {
      "additionalProperties": false,
      "description": "A price or offer the customer says a competitor is providing.",
      "properties": {
        "carrier": {
          "title": "Carrier",
          "type": "string"
        },
        "price": {
          "minimum": 0.0,
          "title": "Price",
          "type": "number"
        },
        "source": {
          "title": "Source",
          "type": "string"
        },
        "span_refs": {
          "items": {
            "type": "string"
          },
          "title": "Span Refs",
          "type": "array"
        },
        "unit": {
          "enum": [
            "per_line",
            "total",
            "ambiguous"
          ],
          "title": "Unit",
          "type": "string"
        }
      },
      "required": [
        "carrier",
        "price",
        "unit",
        "source",
        "span_refs"
      ],
      "title": "CompetitorClaim",
      "type": "object"
    }
  },
  "additionalProperties": false,
  "description": "Request payload for the Competitor agent.",
  "properties": {
    "carriers": {
      "items": {
        "type": "string"
      },
      "title": "Carriers",
      "type": "array"
    },
    "current_monthly": {
      "exclusiveMinimum": 0.0,
      "title": "Current Monthly",
      "type": "number"
    },
    "current_plan_profile": {
      "title": "Current Plan Profile",
      "type": "string"
    },
    "customer_claim": {
      "anyOf": [
        {
          "$ref": "#/$defs/CompetitorClaim"
        },
        {
          "type": "null"
        }
      ]
    },
    "geography": {
      "title": "Geography",
      "type": "string"
    },
    "known_device_financing_payoff": {
      "default": 0.0,
      "minimum": 0.0,
      "title": "Known Device Financing Payoff",
      "type": "number"
    },
    "known_one_time_switching_fees": {
      "default": 0.0,
      "minimum": 0.0,
      "title": "Known One Time Switching Fees",
      "type": "number"
    },
    "line_count": {
      "minimum": 1,
      "title": "Line Count",
      "type": "integer"
    },
    "max_snapshot_age_days": {
      "minimum": 0,
      "title": "Max Snapshot Age Days",
      "type": "integer"
    },
    "switching_context": {
      "title": "Switching Context",
      "type": "string"
    }
  },
  "required": [
    "geography",
    "carriers",
    "line_count",
    "current_plan_profile",
    "current_monthly",
    "customer_claim",
    "switching_context",
    "max_snapshot_age_days"
  ],
  "title": "CompetitorQuery",
  "type": "object"
}
