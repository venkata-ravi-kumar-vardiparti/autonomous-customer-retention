{
  "$defs": {
    "EvidenceRef": {
      "additionalProperties": false,
      "description": "Pointer to the governed-data-layer record backing a claim.",
      "properties": {
        "as_of": {
          "format": "date-time",
          "title": "As Of",
          "type": "string"
        },
        "evidence_id": {
          "title": "Evidence Id",
          "type": "string"
        },
        "freshness": {
          "enum": [
            "fresh",
            "aging",
            "stale"
          ],
          "title": "Freshness",
          "type": "string"
        },
        "masked": {
          "title": "Masked",
          "type": "boolean"
        },
        "record_ref": {
          "title": "Record Ref",
          "type": "string"
        },
        "source_system": {
          "title": "Source System",
          "type": "string"
        }
      },
      "required": [
        "evidence_id",
        "source_system",
        "record_ref",
        "as_of",
        "freshness",
        "masked"
      ],
      "title": "EvidenceRef",
      "type": "object"
    },
    "Telemetry": {
      "additionalProperties": false,
      "description": "Per-call cost/latency accounting attached to every AgentResult.",
      "properties": {
        "cache_hit": {
          "title": "Cache Hit",
          "type": "boolean"
        },
        "cost_usd": {
          "minimum": 0,
          "title": "Cost Usd",
          "type": "number"
        },
        "latency_ms": {
          "minimum": 0,
          "title": "Latency Ms",
          "type": "integer"
        },
        "model": {
          "title": "Model",
          "type": "string"
        },
        "tokens_in": {
          "minimum": 0,
          "title": "Tokens In",
          "type": "integer"
        },
        "tokens_out": {
          "minimum": 0,
          "title": "Tokens Out",
          "type": "integer"
        }
      },
      "required": [
        "model",
        "latency_ms",
        "tokens_in",
        "tokens_out",
        "cost_usd",
        "cache_hit"
      ],
      "title": "Telemetry",
      "type": "object"
    }
  },
  "additionalProperties": false,
  "description": "Response envelope: status, confidence, evidence, and the payload.",
  "properties": {
    "confidence": {
      "maximum": 1.0,
      "minimum": 0.0,
      "title": "Confidence",
      "type": "number"
    },
    "data": {
      "anyOf": [
        {},
        {
          "type": "null"
        }
      ],
      "title": "Data"
    },
    "evidence": {
      "items": {
        "$ref": "#/$defs/EvidenceRef"
      },
      "title": "Evidence",
      "type": "array"
    },
    "missing_evidence": {
      "items": {
        "type": "string"
      },
      "title": "Missing Evidence",
      "type": "array"
    },
    "status": {
      "enum": [
        "ok",
        "partial",
        "stale",
        "failed",
        "insufficient_evidence"
      ],
      "title": "Status",
      "type": "string"
    },
    "telemetry": {
      "$ref": "#/$defs/Telemetry"
    },
    "warnings": {
      "items": {
        "type": "string"
      },
      "title": "Warnings",
      "type": "array"
    }
  },
  "required": [
    "status",
    "confidence",
    "data",
    "evidence",
    "missing_evidence",
    "warnings",
    "telemetry"
  ],
  "title": "AgentResult",
  "type": "object"
}
