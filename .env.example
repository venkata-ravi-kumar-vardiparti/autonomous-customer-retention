# Copy to .env and fill in. Never commit the real .env.
OPENAI_API_KEY=

# SQLite path for the Governed Data Layer (Phase 1+).
CHURNGUARD_DB_PATH=churnguard.db

# Policy pack version applied when none is specified explicitly.
CHURNGUARD_POLICY_PACK_VERSION=0.0.0

# Hard deadline, in milliseconds, for a full Supervisor fan-out round trip.
CHURNGUARD_DEADLINE_MS=2000
